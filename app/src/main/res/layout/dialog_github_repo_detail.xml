<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Icon + name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivDetailIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDetailFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvDetailStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#FFD700"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- Topics -->
        <TextView
            android:id="@+id/tvDetailTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#1E88E5"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <!-- Last tag -->
        <TextView
            android:id="@+id/tvDetailLastTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Open in browser -->
        <Button
            android:id="@+id/btnOpenRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 View on GitHub"
            android:textAllCaps="false"
            android:backgroundTint="#1E88E5"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="12dp" />

        <!-- AutoMode label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Signing mode:"
            android:textSize="13sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="4dp" />

        <!-- AutoMode spinner -->
        <Spinner
            android:id="@+id/spDetailAutoMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Rename package option -->
        <CheckBox
            android:id="@+id/cbRenamePackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rename package (recommended)"
            android:checked="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvRenameHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disable only if the app fails to install with an error code."
            android:textSize="11sp"
            android:textColor="#888888"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>
</ScrollView>
